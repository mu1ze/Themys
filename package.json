{
  "name": "themys",
  "version": "0.1.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mu1ze/Themys.git"
  },
  "bugs": {
    "url": "https://github.com/mu1ze/Themys/issues"
  },
  "scripts": {
    "dev": "next dev",
    "dev:stripe": "./dev.sh",
    "dev:next": "next dev",
    "build": "NODE_OPTIONS=${NODE_OPTIONS:---max-old-space-size=3072} APP_URL=${APP_URL:-https://themys.ca} next build --webpack",
    "build:workers": "opennextjs-cloudflare build",
    "build:cloudflare": "opennextjs-cloudflare build --skipNextBuild",
    "preview": "pnpm build:workers && opennextjs-cloudflare preview --local-protocol https",
    "deploy": "pnpm run verify:release-config && pnpm run verify:stripe-webhook && pnpm build:workers && opennextjs-cloudflare deploy",
    "upload": "pnpm build:workers && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "d1:migrate:local": "wrangler d1 migrations apply themys-db --local --config wrangler.jsonc",
    "d1:migrate:remote": "wrangler d1 migrations apply themys-db --remote --config wrangler.jsonc",
    "d1:migrations:list": "wrangler d1 migrations list themys-db --config wrangler.jsonc",
    "d1:migrations:list:local": "wrangler d1 migrations list themys-db --local --config wrangler.jsonc",
    "d1:migrations:list:remote": "wrangler d1 migrations list themys-db --remote --config wrangler.jsonc",
    "migrate:data:dry-run": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/migrate-legacy-postgrest-to-cloudflare.mjs",
    "migrate:data:apply": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/migrate-legacy-postgrest-to-cloudflare.mjs --apply --source-writes-paused",
    "migrate:data:verify": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/migrate-legacy-postgrest-to-cloudflare.mjs --verify-only",
    "start": "next start",
    "prepare:standalone": "node scripts/prepare-standalone.mjs",
    "start:standalone": "pnpm prepare:standalone && APP_URL=${APP_URL:-https://themys.ca} node --env-file-if-exists=.env --env-file-if-exists=.env.local .next/standalone/server.js",
    "lint": "eslint",
    "typecheck": "NODE_OPTIONS=${NODE_OPTIONS:---max-old-space-size=4096} tsc --noEmit",
    "test": "pnpm run test:unit",
    "test:repo": "node --test scripts/repository-safety.test.mjs",
    "secrets:scan": "node scripts/scan-secrets.mjs",
    "secrets:history": "node scripts/scan-secrets.mjs --history",
    "test:unit": "node --test src/lib/*.test.ts src/contracts/*.test.ts email-worker/src/*.test.ts packages/tos-detection/*.test.js",
    "test:release": "pnpm run test:unit && pnpm run verify:release-config && pnpm run verify:stripe-webhook && pnpm run build:workers",
    "audit:prod": "pnpm audit --prod --audit-level moderate --ignore-registry-errors",
    "verify:release-config": "node scripts/verify-release-config.mjs",
    "verify:stripe-webhook": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/verify-stripe-webhook.mjs",
    "verify:monitoring-cron": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/verify-monitoring-cron.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "extension:build:dev": "pnpm --dir extension run build:dev",
    "extension:build:staging": "pnpm --dir extension run build:staging",
    "extension:build:prod": "pnpm --dir extension run build:prod",
    "extension:validate:prod": "pnpm --dir extension run validate:prod",
    "docs:dev": "pnpm --dir docs dev",
    "docs:build": "pnpm --dir docs build",
    "docs:deploy": "pnpm --dir docs deploy",
    "ios:sync": "node scripts/sync-ios-safari-extension.mjs",
    "macos:safari:sync": "node scripts/sync-macos-safari-extension.mjs",
    "email-worker:verify:staging": "node scripts/verify-email-worker-config.mjs staging",
    "email-worker:verify:production": "node scripts/verify-email-worker-config.mjs production",
    "email-worker:deploy:staging": "pnpm email-worker:verify:staging && npx wrangler deploy --config email-worker/wrangler.jsonc --env staging",
    "email-worker:deploy:production": "pnpm email-worker:verify:production && npx wrangler deploy --config email-worker/wrangler.jsonc --env=\"\"",
    "ios:test": "node --test ios/tests/*.test.ts packages/tos-detection/*.test.js src/lib/themys-client.test.ts"
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.7.1",
    "@react-pdf/renderer": "^4.5.1",
    "@sentry/browser": "10.70.0",
    "@sentry/cloudflare": "10.70.0",
    "@stripe/stripe-js": "^9.8.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.21.0",
    "motion": "^12.43.0",
    "next": "16.3.8",
    "openai": "^6.44.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.9.1",
    "stripe": "^22.2.2",
    "tailwind-merge": "^3.6.0",
    "unpdf": "1.8.0"
  },
  "devDependencies": {
    "@clerk/backend": "^3.16.1",
    "@clerk/testing": "^2.2.47",
    "@opennextjs/cloudflare": "^1.20.6",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.131.0"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "overrides": {
      "@eslint/eslintrc>js-yaml": "4.3.2",
      "brace-expansion@>=1.0.0 <1.1.21": "1.1.21",
      "brace-expansion@>=2.0.0 <2.1.7": "2.1.7",
      "brace-expansion@>=5.0.0 <5.0.12": "5.0.12",
      "proxy-addr": "2.0.8",
      "@tailwindcss/postcss>postcss": "8.5.23",
      "next>postcss": "8.5.23",
      "postcss>nanoid": "3.3.18",
      "qs": "6.16.0",
      "sharp": "0.35.5",
      "source-map-js": "1.2.2",
      "undici@>=7.0.0 <7.29.1": "7.29.1"
    }
  }
}
