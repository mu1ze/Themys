# Playwright + Clerk E2E Testing
# Merge the needed values into your ignored .env.local after the README setup.
# These are required for `pnpm test:e2e` to authenticate with Clerk.

# Clerk secret key (backend) — from Clerk dashboard > Settings > API keys
CLERK_SECRET_KEY=sk_test_...

# Clerk publishable key (frontend)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# Optional. The setup auto-provisions e2e+clerk_test@themys.ca when omitted.
# CLERK_TEST_USER_EMAIL=your+clerk_test@example.com

# Clerk ID of that same test user, granting admin-route access only in E2E.
ADMIN_CLERK_IDS=user_...

# Random server-side key used to HMAC anonymous analytics fingerprints.
USAGE_FINGERPRINT_SECRET=replace-with-at-least-32-random-bytes

# Optional: override the base URL for tests (default: http://localhost:3000)
# PLAYWRIGHT_BASE_URL=http://localhost:3000

# Remote Cloudflare resources used by authenticated smoke tests and migration
# verification. The API token needs D1 Read/Write and R2 object access.
CLOUDFLARE_ACCOUNT_ID=replace-with-account-id
CLOUDFLARE_D1_DATABASE_ID=replace-with-d1-database-id
CLOUDFLARE_API_TOKEN=replace-with-test-token
CLOUDFLARE_R2_BUCKET=themys-documents

# Stripe test-mode credentials. Never use live keys for mutable E2E tests.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_BASE_MONTHLY=price_...
STRIPE_PRICE_BASE_ANNUAL=price_...
STRIPE_PRICE_ADVANCED_MONTHLY=price_...
STRIPE_PRICE_ADVANCED_ANNUAL=price_...
STRIPE_PRICE_CREDITS_10=price_...
STRIPE_PRICE_CREDITS_50=price_...
STRIPE_PRICE_CREDITS_200=price_...

# Monitoring email Worker integration uses a Cloudflare service binding in
# deployed Workers. Local tests can inject a fake binding in their harness.
MONITORING_EMAIL_FROM=alerts@themys.ca
