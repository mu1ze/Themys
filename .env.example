# Copy to .env.local. Use credentials from your OWN Clerk development instance.
# Leave optional features blank until you need them. Never paste live secrets here.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Local Next.js defaults to http://localhost:3000 when APP_URL is omitted.
# For production builds, set APP_URL to your own HTTPS origin.
APP_URL=
# Optional extra development hostnames, comma separated, without scheme or port.
DEV_ALLOWED_ORIGINS=

# Required for real document analysis; external provider requests may incur cost.
OPENROUTER_API_KEY=
# Optional clause detection provider (OpenRouter remains necessary for extraction).
JEV_API_KEY=
# Optional authenticated URL extraction.
JINA_READER_KEY=

# Optional local billing. Use a Stripe test account and test-mode Price IDs.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASE_MONTHLY=
STRIPE_PRICE_BASE_ANNUAL=
STRIPE_PRICE_ADVANCED_MONTHLY=
STRIPE_PRICE_ADVANCED_ANNUAL=
STRIPE_PRICE_CREDITS_10=
STRIPE_PRICE_CREDITS_50=
STRIPE_PRICE_CREDITS_200=

# Optional server-side features. Generate fresh random secrets locally.
USAGE_FINGERPRINT_SECRET=
CRON_SECRET=
# Your own Clerk user IDs only; grants administrative access.
ADMIN_CLERK_IDS=
# Optional error reporting and feedback challenge.
SENTRY_DSN=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# D1, R2, and KV are local Wrangler bindings, not database API credentials.
# No Cloudflare API token is needed for normal local development.
