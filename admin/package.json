{
  "name": "themys-admin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "d1:migrate:local": "wrangler d1 migrations apply themys-db --local --config wrangler.jsonc",
    "build": "NEXT_PUBLIC_APP_URL=${NEXT_PUBLIC_APP_URL:-https://admin.themys.ca} next build --webpack",
    "build:workers": "opennextjs-cloudflare build",
    "deploy": "pnpm build:workers && opennextjs-cloudflare deploy",
    "upload": "pnpm build:workers && opennextjs-cloudflare upload",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm --dir .. exec eslint admin/next.config.ts admin/src src/components/admin src/features/admin/metrics",
    "test:metrics": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.5.7",
    "@react-pdf/renderer": "^4.5.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.21.0",
    "motion": "^12.43.0",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.10.1",
    "stripe": "22.2.2",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.103.0"
  },
  "pnpm": {
    "overrides": {
      "next>postcss": "8.5.15"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd",
      "@tailwindcss/oxide",
      "@parcel/watcher",
      "lightningcss"
    ]
  }
}
