{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "themysdocs",
  "main": "worker.ts",
  "compatibility_date": "2026-06-17",
  "routes": [
    {
      "pattern": "docs.themys.ca",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "out",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  }
}
